# =============================================================================
# Configuration Light Church - Variables d'environnement
# =============================================================================
#
# Instructions:
# 1. Copier ce fichier vers .env : cp .env.example .env
# 2. Modifier les valeurs selon votre environnement
# 3. Ne JAMAIS committer le fichier .env (contient des secrets)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=light_church
MYSQL_USER=admin
MYSQL_PASSWORD=admin

# Port exposé sur l'hôte (modifiable en cas de conflit)
# Par défaut: 3306 (port standard MySQL)
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# Backend Express
# -----------------------------------------------------------------------------
# Port exposé sur l'hôte (modifiable en cas de conflit)
# Par défaut: 3000
# ⚠️ Si vous changez ce port, le frontend s'adaptera automatiquement
EXPRESS_PORT=3000

# Secret pour les tokens JWT (OBLIGATOIRE en production)
# ⚠️ Générer une clé forte: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_key

# -----------------------------------------------------------------------------
# Frontend React
# -----------------------------------------------------------------------------
# Port exposé sur l'hôte pour accéder au frontend
# Par défaut: 80 (http://localhost)
# Si 80 est occupé, utiliser 8080 ou autre : http://localhost:8080
FRONTEND_PORT=80

# -----------------------------------------------------------------------------
# Exemples de configuration pour différents environnements
# -----------------------------------------------------------------------------

# --- Mac (développement) ---
# MYSQL_PORT=3306
# EXPRESS_PORT=3000
# FRONTEND_PORT=80

# --- Linux (conflit Grafana sur 3000, PHP/MySQL sur 3306) ---
# MYSQL_PORT=3307
# EXPRESS_PORT=5000
# FRONTEND_PORT=8080

# --- Windows (ports standards) ---
# MYSQL_PORT=3306
# EXPRESS_PORT=3000
# FRONTEND_PORT=80
