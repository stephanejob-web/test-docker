# =============================================================================
# Configuration pour Linux avec Grafana (port 3000) et MySQL (port 3306)
# =============================================================================
#
# Utilisation :
# cp .env.linux .env
# docker-compose down -v
# docker-compose up -d --build
#
# =============================================================================

# Base de données MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=light_church
MYSQL_USER=admin
MYSQL_PASSWORD=admin
MYSQL_PORT=3307           # ✅ Évite conflit avec MySQL système (3306)

# Backend Express
EXPRESS_PORT=5000         # ✅ Évite conflit avec Grafana (3000)

# Secret JWT
JWT_SECRET=super_secret_jwt_key

# Frontend React
FRONTEND_PORT=8080        # ✅ Port alternatif (80 peut nécessiter sudo)

# =============================================================================
# Accès après démarrage :
# - Frontend : http://localhost:8080
# - Backend API : http://localhost:5000/api
# - MySQL : localhost:3307
# =============================================================================
